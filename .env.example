# Application
NODE_ENV=development
PORT=3000
APP_NAME=wdk-backend

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=wdk_dev
DB_SYNCHRONIZE=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth (OIDC/JWT)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=3600
AUTH_PROVIDER=auth0
AUTH_ISSUER=https://your-auth-provider.auth0.com/
AUTH_AUDIENCE=https://your-backend-api
JWKS_URI=https://your-auth-provider.auth0.com/.well-known/jwks.json

# Encryption
SEED_BACKUP_ENCRYPTION_KEY=your-encryption-key-change-in-production

# WDK Indexer
INDEXER_BASE_URL=https://wdk-api.tether.io/api/v1
INDEXER_API_KEY=

# Smart Contract
UTILITY_TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
UTILITY_TOKEN_CONTRACT_ABI=[]

# Supported Chains & Networks
SUPPORTED_CHAINS=BTC,SPARK,ARBITRUM,ETHEREUM,POLYGON,TRON
SUPPORTED_ASSETS=BTC,USDT

# Logging
LOG_LEVEL=debug
