# Application
NODE_ENV=development
PORT=3000
APP_NAME=wdk-backend
CORS_ORIGINS=*

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=wdk_dev
DB_SYNCHRONIZE=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth (OIDC/JWT)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800
AUTH_PROVIDER=auth0
AUTH_ISSUER=https://your-auth-provider.auth0.com/
AUTH_AUDIENCE=https://your-backend-api
JWKS_URI=https://your-auth-provider.auth0.com/.well-known/jwks.json
# Google OAuth (Platform-specific Client IDs)
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id

# Encryption
SEED_BACKUP_ENCRYPTION_KEY=your-encryption-key-change-in-production

# WDK Indexer
INDEXER_BASE_URL=https://wdk-api.tether.io/api/v1
INDEXER_API_KEY=

# Smart Contract
UTILITY_TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
UTILITY_TOKEN_CONTRACT_ABI=[]

# Supported Chains & Networks
SUPPORTED_CHAINS=BTC,SPARK,ARBITRUM,ETHEREUM,POLYGON,TRON
SUPPORTED_ASSETS=BTC,USDT

# Logging
LOG_LEVEL=debug

PAYMENT_POLL_INTERVAL_MS=30000
PAYMENT_POLL_PAGE_SIZE=50
PAYMENT_POLL_MAX_MERCHANTS=20

# History and balances
# How long a device-reported transaction may stay pending before it is marked
# failed / NOT_OBSERVED, and how often that sweep runs (0 disables it).
TX_OBSERVATION_TIMEOUT_MS=7200000
TX_SWEEP_INTERVAL_MS=60000
# Age at which GET /balances schedules a refresh behind the response.
BALANCE_CACHE_TTL_MS=60000
CONFIRMATION_DEPTHS={"1":12,"42161":20,"11155111":12,"421614":5,"80002":20,"4294967297":20,"4294967298":3,"4294967299":3}
RPC_URLS={"1":"https://ethereum-rpc.publicnode.com","42161":"https://arbitrum-one-rpc.publicnode.com","11155111":"https://ethereum-sepolia-rpc.publicnode.com"}
# Tron and Bitcoin have one free public API each; every EVM chain still
# demands a separate endpoint per process.
RPC_SHARING_ALLOWED_CHAINS=[4294967297,4294967298]

# Pricing service (BE-08)
PRICING_POLL_INTERVAL_MS=30000
PRICING_BATCH_SIZE=25

# Accrual service (BE-09)
UTL_USD_RATE=1
CASHBACK_BPS=500
ACCRUAL_POLL_INTERVAL_MS=30000
ACCRUAL_BATCH_SIZE=50

# Claims (BE-11)
REWARD_CHAIN_ID=11155111
ATTESTATION_THRESHOLD=1
CLAIM_COOLDOWN_HOURS=24
CLAIM_DEADLINE_SECONDS=3600
CLAIM_SWEEP_INTERVAL_MS=60000

ISSUER_ID=issuer-a
ISSUER_RPC_URL=
ISSUER_SIGNING_KEY=enc:argon2id$m=65536,t=3,p=1$<salt>$<ciphertext>
ISSUER_PRICE_PROVIDER=bitfinex
ISSUER_POLL_INTERVAL_MS=15000
ISSUER_BATCH_SIZE=25
PRICE_TOLERANCE_BPS=100
PRICE_WINDOW_SECONDS=21600
COUPON_CLAIM_CONTRACT_ADDRESS=0x5Dfc68FD44CCD83DD10cF5aA4B060AAe1602fb13
TOKEN_ADDRESSES={"1":{"usdt":"0xdAC17F958D2ee523a2206206994597C13D831ec7"},"42161":{"usdt":"0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9"},"11155111":{"usdt":"0x<usdt-on-sepolia>"}}

# Signer keys. Never commit real ciphertext or the password to this file.
#   npm run key:password                       -> SIGNER_KEY_PASSWORD
#   echo 0x<privkey> | npm run key:encrypt     -> enc:argon2id$...
SIGNER_KEY_PASSWORD=
RELAYER_SIGNING_KEY=
GUARDIAN_SIGNING_KEY=

RELAYER_ID=relayer
RELAYER_RPC_URL=
RELAYER_POLL_INTERVAL_MS=0
RELAYER_BATCH_SIZE=10
RELAYER_CONFIRMATIONS=2
RELAYER_DEADLINE_MARGIN_SECONDS=120
RELAYER_MAX_FEE_GWEI=100

SETTLEMENT_RPC_URL=
SETTLEMENT_POLL_INTERVAL_MS=0
SETTLEMENT_START_BLOCK=0
MONITOR_RPC_URL=
MONITOR_POLL_INTERVAL_MS=0
MONITOR_AUTO_PAUSE=false
ALERT_WEBHOOK_URL=
# Only for Telegram sendMessage URLs: the chat/group id alerts are posted to.
ALERT_TELEGRAM_CHAT_ID=
