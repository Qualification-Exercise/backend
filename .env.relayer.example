# The relayer process: the only key in the system that can spend.
#   RELAYER_ENV_FILE=.env.relayer npm run relayer
#
# Its endpoint must differ from the API's and from every issuer's — it is the
# second independent verifier, and a shared node makes it an echo. The process
# refuses to start otherwise.

RELAYER_ID=relayer
RELAYER_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<relayer-key>
RELAYER_SIGNING_KEY=enc:argon2id$m=65536,t=3,p=1$<salt>$<ciphertext>
SIGNER_KEY_PASSWORD=

RELAYER_POLL_INTERVAL_MS=15000
RELAYER_BATCH_SIZE=10
RELAYER_CONFIRMATIONS=2
# Do not submit an entitlement this close to expiry: the transaction would revert.
RELAYER_DEADLINE_MARGIN_SECONDS=120
RELAYER_MAX_FEE_GWEI=100

REWARD_CHAIN_ID=11155111
COUPON_CLAIM_CONTRACT_ADDRESS=0x5Dfc68FD44CCD83DD10cF5aA4B060AAe1602fb13
TOKEN_ADDRESSES={"11155111":{"usdt":"0x<usdt-on-sepolia>"}}
CONFIRMATION_DEPTHS={"11155111":12}

# Database: the relayer role can read claims/attestations/payments and update
# claim status. It cannot insert attestations or coupons — see docs/db-roles.sql.
DB_HOST=
DB_PORT=5432
DB_USERNAME=relayer
DB_PASSWORD=
DB_NAME=
