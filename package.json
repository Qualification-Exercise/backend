{
  "name": "wdk-backend",
  "version": "0.1.0",
  "description": "Backend scaffold for Tether WDK Qualification Exercise",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint src scripts test --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src scripts test --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write \"{src,scripts}/**/*.ts\"",
    "format:check": "prettier --check \"{src,scripts}/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "docker:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "dev:token": "ts-node -r tsconfig-paths/register scripts/dev-token.ts",
    "poll:once": "ts-node -r tsconfig-paths/register scripts/poll-once.ts",
    "issuer": "ts-node -r tsconfig-paths/register src/issuer/main.ts",
    "issue:once": "ts-node -r tsconfig-paths/register scripts/issue-once.ts",
    "relayer": "ts-node -r tsconfig-paths/register src/relayer/main.ts",
    "relay:once": "ts-node -r tsconfig-paths/register scripts/relay-once.ts",
    "settlement": "ts-node -r tsconfig-paths/register src/settlements/main.ts",
    "monitor": "ts-node -r tsconfig-paths/register src/monitor/main.ts",
    "key:password": "ts-node -r tsconfig-paths/register scripts/encrypt-key.ts --password",
    "key:encrypt": "ts-node -r tsconfig-paths/register scripts/encrypt-key.ts",
    "verify:signer": "ts-node -r tsconfig-paths/register scripts/verify-signer.ts",
    "monitor:pause-drill": "ts-node -r tsconfig-paths/register scripts/pause-drill.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qualification-Exercise/backend.git"
  },
  "keywords": [
    "nestjs",
    "typeorm",
    "postgres",
    "wdk",
    "tether"
  ],
  "author": "Qualification Exercise",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/Qualification-Exercise/backend/issues"
  },
  "homepage": "https://github.com/Qualification-Exercise/backend#readme",
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.1.0",
    "@nestjs/typeorm": "^11.0.3",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^1.2.6",
    "@tetherto/wdk-pricing-bitfinex-http": "^1.0.0-beta.4",
    "@tetherto/wdk-utils": "^1.0.0-beta.10",
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.16",
    "axios": "^1.18.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "opossum": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "typeorm": "^1.1.0",
    "viem": "^2.55.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.2",
    "@types/opossum": "^8.1.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "axios": "$axios",
    "@nestjs/swagger": {
      "js-yaml": "^5.2.3"
    },
    "cosmiconfig": {
      "js-yaml": "^4.3.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.1"
    }
  }
}
