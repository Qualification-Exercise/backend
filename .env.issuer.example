# One issuer process = one copy of this file.
#   ISSUER_ENV_FILE=.env.issuer-a npm run issuer
#   ISSUER_ENV_FILE=.env.issuer-b npm run issuer
#
# A third issuer is a third copy — no code changes. What must differ between
# them is the whole point of the layer: shared RPC or shared keys collapse N
# signers back into one, so the process refuses to start on a shared endpoint.

ISSUER_ID=issuer-a
ISSUER_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<issuer-a-key>
ISSUER_SIGNING_KEY=env:0x<issuer-a-private-key>ё
ISSUER_PRICE_PROVIDER=bitfinex

ISSUER_POLL_INTERVAL_MS=15000
ISSUER_BATCH_SIZE=25
PRICE_TOLERANCE_BPS=100
PRICE_WINDOW_SECONDS=21600

REWARD_CHAIN_ID=11155111
COUPON_CLAIM_CONTRACT_ADDRESS=0x5Dfc68FD44CCD83DD10cF5aA4B060AAe1602fb13
TOKEN_ADDRESSES={"1":{"usdt":"0xdAC17F958D2ee523a2206206994597C13D831ec7"}}
UTL_USD_RATE=1
CASHBACK_BPS=500
CLAIM_COOLDOWN_HOURS=24

DB_HOST=
DB_PORT=5432
DB_USERNAME=issuer
DB_PASSWORD=
DB_NAME=
