# Settlement watcher (BE-15). No key at all: it reads events and writes what it saw.
#   SETTLEMENT_ENV_FILE=.env.settlement npm run settlement

# The reward chain only: Claimed events are emitted where the rewards settle,
# which is Sepolia. Payment detection is somebody else's job.
SETTLEMENT_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<watcher-key>
SETTLEMENT_POLL_INTERVAL_MS=20000
SETTLEMENT_CONFIRMATIONS=5
SETTLEMENT_BLOCK_RANGE=2000
SETTLEMENT_TIMEOUT_MS=900000
# The deployment block, so the first pass does not scan the whole chain.
SETTLEMENT_START_BLOCK=0

REWARD_CHAIN_ID=11155111
COUPON_CLAIM_CONTRACT_ADDRESS=0x5Dfc68FD44CCD83DD10cF5aA4B060AAe1602fb13
ALERT_WEBHOOK_URL=

DB_HOST=
DB_PORT=5432
DB_USERNAME=settlement
DB_PASSWORD=
DB_NAME=
