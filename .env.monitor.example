# Monitor (BE-17). Runs in a SEPARATE cloud account from everything it watches,
# with separate credentials and the guardian key — and no other key.
#   MONITOR_ENV_FILE=.env.monitor npm run monitor
#
# Drill the pause path before the demo:
#   MONITOR_ENV_FILE=.env.monitor npm run monitor:pause-drill -- --check
#   MONITOR_ENV_FILE=.env.monitor npm run monitor:pause-drill

# The reward chain: totalSupply, epoch caps and pause() live there.
MONITOR_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<monitor-key>
# The payment chains it samples against the indexer's claims.
MONITOR_RPC_URLS={"1":"https://eth-mainnet.example/v2/<monitor-key>"}
MONITOR_SIGNING_KEY=enc:argon2id$m=65536,t=3,p=1$<salt>$<ciphertext>
SIGNER_KEY_PASSWORD=

MONITOR_POLL_INTERVAL_MS=60000
MONITOR_SUPPLY_TOLERANCE_BPS=50
MONITOR_SAMPLE_SIZE=10
MONITOR_EPOCH_UTILISATION_PCT=80
MONITOR_MAX_INDEXER_LAG_SECONDS=600
MONITOR_MAX_INDEXER_ERROR_PCT=20
# Off until someone decides the monitor may stop the system on its own.
MONITOR_AUTO_PAUSE=false

REWARD_CHAIN_ID=11155111
COUPON_CLAIM_CONTRACT_ADDRESS=0x5Dfc68FD44CCD83DD10cF5aA4B060AAe1602fb13
UTILITY_TOKEN_CONTRACT_ADDRESS=0x63dE56C3909825e1d83e69daDa3f1e9E379f71AD
TOKEN_ADDRESSES={"1":{"usdt":"0xdAC17F958D2ee523a2206206994597C13D831ec7"}}
CASHBACK_BPS=500
UTL_USD_RATE=1
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_CHAT_ID=

# Read-only database user: the monitor observes, it does not repair.
DB_HOST=
DB_PORT=5432
DB_USERNAME=monitor
DB_PASSWORD=
DB_NAME=
